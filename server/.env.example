# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env (ele já está no .gitignore).

# Conexão com o PostgreSQL
DATABASE_URL="postgresql://noely:noely@localhost:5432/noely_cerqueira?schema=public"

# Porta da API
PORT=3333

# Segredo para assinatura dos tokens JWT (gere um valor aleatório forte em produção)
JWT_SECRET="troque-por-um-valor-aleatorio-longo-em-producao"
JWT_EXPIRES_IN="8h"

# Origem permitida para requisições do frontend (CORS)
WEB_ORIGIN="http://localhost:5173"

# Credenciais do usuário administrador criado pelo seed inicial
ADMIN_SEED_EMAIL="noelydesouzacerqueiradossantos@gmail.com"
ADMIN_SEED_PASSWORD="troque-esta-senha-no-primeiro-acesso"

# Fuso horário do tenant (Camaçari/BA)
TENANT_TIMEZONE="America/Bahia"

# WhatsApp Cloud API (Meta) — lembretes de retorno e aniversário do módulo de
# pacientes. Opcionais: sem elas, o botão de enviar WhatsApp na ficha do
# paciente mostra um erro claro em vez de falhar silenciosamente; o resto do
# painel (lembretes na tela, agenda, fichas) funciona normalmente sem isso.
# Como obter: crie um app em developers.facebook.com > WhatsApp > Configuração
# da API, gere um token de acesso permanente e pegue o Phone Number ID.
# WHATSAPP_CLOUD_API_TOKEN="seu-token-de-acesso-da-meta"
# WHATSAPP_PHONE_NUMBER_ID="id-do-numero-de-telefone-configurado"
# WHATSAPP_API_VERSION="v21.0"
