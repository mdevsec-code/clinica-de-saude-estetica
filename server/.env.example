# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env (ele já está no .gitignore).

# Conexão com o PostgreSQL
DATABASE_URL="postgresql://noely:noely@localhost:5432/noely_cerqueira?schema=public"
# DIRECT_DATABASE_URL é a conexão usada só pelas migrations. Com o Postgres
# na própria VPS (ver DEPLOY.md) ou local, não há pooler, então as duas
# apontam pro mesmo banco. Só diferem num banco com pooler (ex.: Neon).
DIRECT_DATABASE_URL="postgresql://noely:noely@localhost:5432/noely_cerqueira?schema=public"

# Porta da API
PORT=3333

# Segredo para assinatura dos tokens JWT (gere um valor aleatório forte em produção)
JWT_SECRET="troque-por-um-valor-aleatorio-longo-em-producao"
JWT_EXPIRES_IN="8h"

# Origem permitida para requisições do frontend (CORS)
WEB_ORIGIN="http://localhost:5173"

# Quantos proxies reversos ficam na frente da API: 0 em desenvolvimento,
# 1 em produção atrás do Nginx na VPS (necessário para os limites de
# tentativas por IP funcionarem por visitante, não para todos juntos).
TRUST_PROXY=0

# Credenciais do usuário administrador criado pelo seed inicial
ADMIN_SEED_EMAIL="admin@exemplo.com.br"
ADMIN_SEED_PASSWORD="troque-esta-senha-no-primeiro-acesso"

# Fuso horário do tenant (Camaçari/BA)
TENANT_TIMEZONE="America/Bahia"


# WhatsApp Cloud API (Meta) — lembretes de retorno e aniversário do módulo de
# pacientes. Opcionais: sem elas, o botão de enviar WhatsApp na ficha do
# paciente mostra um erro claro em vez de falhar silenciosamente; o resto do
# painel (lembretes na tela, agenda, fichas) funciona normalmente sem isso.
# Como obter: crie um app em developers.facebook.com > WhatsApp > Configuração
# da API, gere um token de acesso permanente e pegue o Phone Number ID.
# WHATSAPP_CLOUD_API_TOKEN="seu-token-de-acesso-da-meta"
# WHATSAPP_PHONE_NUMBER_ID="id-do-numero-de-telefone-configurado"
# WHATSAPP_API_VERSION="v21.0"

# Google Agenda da clínica — opcional. Com as duas primeiras definidas:
#   - todo agendamento confirmado vira evento na agenda (some se cancelar);
#   - compromissos marcados direto na agenda bloqueiam o horário no site
#     (sincroniza a cada GOOGLE_CALENDAR_SYNC_INTERVAL_MIN minutos).
# Como obter (ver DEPLOY.md, seção Google Agenda): crie uma conta de serviço
# no Google Cloud com a Google Calendar API ativada, baixe a chave JSON e
# compartilhe a agenda com o e-mail da conta de serviço ("Fazer alterações
# nos eventos"). GOOGLE_CALENDAR_ID é o e-mail da agenda (ex.: o Gmail da
# Noely) ou o "ID da agenda" mostrado nas configurações dela.
# GOOGLE_CALENDAR_ID="agenda-da-clinica@gmail.com"
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE="/opt/noely/server/google-service-account.json"
# GOOGLE_CALENDAR_SYNC_INTERVAL_MIN=5

# Armazenamento de arquivo (fotos de paciente, fichas digitalizadas) em
# object storage compatível com S3 — obrigatório em produção numa hospedagem
# com disco efêmero (Railway, Render etc.: o disco local é apagado a cada
# deploy). Sem estas 5 variáveis, cai para disco local automaticamente (bom
# para desenvolvimento, ver lib/file-storage.ts). Recomendado: Supabase
# Storage (free tier permanente) — ver DEPLOY.md para o passo a passo de
# criar o bucket e gerar essas credenciais (Project Settings > Storage > S3
# Connection).
# S3_ENDPOINT="https://SEU-PROJETO.supabase.co/storage/v1/s3"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="sua-access-key-do-token-s3-do-supabase"
# S3_SECRET_ACCESS_KEY="sua-secret-key-do-token-s3-do-supabase"
# S3_BUCKET_NAME="noely-cerqueira-uploads"
