generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cada linha relevante do sistema carrega tenantId: isolamento de dados
// entre clínicas é feito sempre por filtro explícito de tenant, nunca implícito.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("America/Bahia")
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  users             User[]
  customers         Customer[]
  serviceCategories ServiceCategory[]
  services          Service[]
  businessHours     BusinessHour[]
  blockedTimes      BlockedTime[]
  appointments      Appointment[]
  settings          TenantSettings?
  expenses          Expense[]
  inventoryItems    InventoryItem[]
  bankTransactions  BankTransaction[]
  auditLogs         AuditLog[]
}

enum UserRole {
  ADMIN
  RECEPTION
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  email        String
  passwordHash String
  role         UserRole @default(RECEPTION)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  auditLogs AuditLog[]

  @@unique([tenantId, email])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// Trilha de auditoria (Fase 3): um registro por ação de escrita feita por um
// usuário AUTENTICADO do painel — nunca de agendamentos públicos (a rota de
// booking não passa por requireAuth, então req.user nunca existe ali; ver
// auditLogger em middleware/audit.middleware.ts). Sem relação CASCADE em
// User de propósito: um log de auditoria precisa sobreviver mesmo que a
// conta que fez a ação um dia deixe de existir — por isso userName também
// fica congelado aqui (snapshot no momento da ação), não só o id.
model AuditLog {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  userName    String
  action      AuditAction
  entityType  String
  entityId    String?
  entityLabel String?
  method      String
  path        String
  // Corpo da requisição (o que foi de fato enviado), com campos sensíveis
  // (senha etc.) removidos antes de salvar — ver redactSensitive() em
  // audit.middleware.ts. Guardado bruto (não um diff antes/depois) por
  // simplicidade: o objetivo aqui é "o que foi enviado", não um histórico de
  // versão campo a campo.
  changes     Json?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType])
  @@index([tenantId, userId])
}

// Configurações públicas da clínica (contato, redes sociais, regras de agendamento).
// Nunca hardcoded no frontend — tudo consultado via API.
model TenantSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  whatsapp           String
  instagram          String
  email              String
  address            String
  addressMapUrl      String?
  minAdvanceMinutes  Int      @default(120)
  slotGranularityMin Int      @default(15)
  maxAdvanceDays     Int      @default(60)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

model Customer {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  whatsapp  String
  email     String?
  birthDate DateTime? @db.Date
  notes     String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  appointments Appointment[]

  @@index([tenantId, whatsapp])
}

model ServiceCategory {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  name      String
  slug      String
  imageUrl  String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  // Marca o "carro-chefe" da clínica (hoje: Harmonização Facial e Corporal) —
  // usado para dar destaque visual próprio na home, sem depender de assumir
  // "a primeira categoria da lista" no frontend.
  featured  Boolean @default(false)

  services Service[]

  @@unique([tenantId, slug])
}

model Service {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id])
  name            String
  slug            String
  description     String?
  durationMinutes Int
  bufferMinutes   Int             @default(0)
  priceCents      Int?
  imageUrl        String?
  active          Boolean         @default(true)
  sortOrder       Int             @default(0)

  appointments Appointment[]

  @@unique([tenantId, slug])
}

// Horário de funcionamento recorrente por dia da semana (0 = domingo ... 6 = sábado).
// Pode haver múltiplas faixas no mesmo dia (ex.: manhã e tarde).
model BusinessHour {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  weekday  Int
  opensAt  String // "09:00"
  closesAt String // "17:00"
  active   Boolean @default(true)

  @@index([tenantId, weekday])
}

// Bloqueios pontuais: folgas, férias, feriados, eventos externos importados do Google Calendar (fase futura).
model BlockedTime {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  startAt   DateTime @db.Timestamptz(3)
  endAt     DateTime @db.Timestamptz(3)
  reason    String?
  source    String   @default("MANUAL") // MANUAL | GOOGLE_CALENDAR (fase futura)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, startAt, endAt])
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  PUBLIC_SITE
  INTERNAL
}

model Appointment {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id])
  serviceId   String
  service     Service           @relation(fields: [serviceId], references: [id])
  // timestamptz (não o timestamp sem fuso padrão do Prisma) de propósito: o
  // código inteiro trata startAt/endAt como instantes absolutos em UTC (é
  // assim que availability.service.ts e o frontend calculam tudo), e a
  // EXCLUDE CONSTRAINT anti-double-booking (ver prisma/manual-sql/001) precisa
  // de timestamptz para construir um tstzrange de forma imutável — com
  // timestamp sem fuso, a conversão implícita depende da sessão e nunca
  // poderia ser imutável.
  startAt     DateTime          @db.Timestamptz(3)
  endAt       DateTime          @db.Timestamptz(3)
  status      AppointmentStatus @default(CONFIRMED)
  source      AppointmentSource @default(PUBLIC_SITE)
  notes       String?
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  cancelledAt DateTime?         @db.Timestamptz(3)

  // A prevenção definitiva de double-booking (item 26 do escopo) NÃO depende só
  // desta constraint do Prisma: uma EXCLUDE constraint via btree_gist é aplicada
  // por SQL manual (ver prisma/manual-sql/001_appointment_no_overlap.sql) para
  // impedir, a nível de banco, qualquer sobreposição de horário confirmada,
  // mesmo sob concorrência. Este índice apenas acelera as consultas de disponibilidade.
  @@index([tenantId, startAt, endAt])
  @@index([tenantId, status])
}

enum ExpenseCategory {
  PRODUTOS
  EQUIPAMENTOS
  ALUGUEL
  MARKETING
  SALARIOS
  OUTROS
}

enum ExpenseStatus {
  PENDING
  PAID
}

// Controle financeiro de gastos (Fase 2). Somado a Service.priceCents dos
// atendimentos concluídos, dá a base de receita x despesa do dashboard —
// nada de projeção/estimativa inventada, só o que foi de fato cadastrado.
//
// status/dueAt/paidAt (Fase 3 — vencimentos): um gasto nasce PENDING com
// dueAt preenchido (ainda não pago, vence em tal dia) ou já PAID com paidAt
// preenchido (lançado como já quitado, fluxo antigo de antes desta fase
// continua funcionando sem mudança nenhuma). paidAt vira nulo só enquanto
// PENDING — markExpensePaid (finance.service.ts) é o único caminho que
// transiciona PENDING → PAID, preenchendo paidAt no momento da baixa.
model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  description String
  category    ExpenseCategory @default(OUTROS)
  amountCents Int
  status      ExpenseStatus   @default(PAID)
  dueAt       DateTime?       @db.Date
  paidAt      DateTime?       @db.Date
  notes       String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  bankTransactions BankTransaction[]

  @@index([tenantId, paidAt])
  @@index([tenantId, dueAt])
  @@index([tenantId, status])
}

enum BankTransactionStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

// Conciliação bancária (Fase 3): transações importadas de um extrato OFX
// (formato padrão de exportação bancária, o mesmo usado pelo Microsoft
// Money — daí o pedido específico por "OFX money"). fitId é o identificador
// único que o PRÓPRIO banco atribui a cada transação dentro do arquivo OFX
// (tag FITID) — é a chave de deduplicação: reimportar o mesmo extrato (ou um
// período sobreposto) nunca duplica lançamentos, só ignora o que já existe.
// amountCents mantém o sinal original do OFX (negativo = saída/débito,
// positivo = entrada/crédito) em vez de normalizar para módulo, porque a
// tela de conciliação precisa distinguir os dois fluxos.
model BankTransaction {
  id               String                @id @default(cuid())
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  fitId            String
  postedAt         DateTime              @db.Date
  amountCents      Int
  description      String
  memo             String?
  status           BankTransactionStatus @default(UNMATCHED)
  matchedExpenseId String?
  matchedExpense   Expense?              @relation(fields: [matchedExpenseId], references: [id])
  importedAt       DateTime              @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, fitId])
  @@index([tenantId, status])
  @@index([tenantId, postedAt])
}

// Controle de estoque (Fase 2). quantity é ajustada diretamente (delta) via
// endpoint dedicado em vez de um livro-razão de movimentações separado —
// suficiente para o volume de uma clínica de porte único, sem a complexidade
// extra de uma tabela de auditoria que ninguém pediu ainda.
model InventoryItem {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  unit        String   @default("un")
  quantity    Int      @default(0)
  minQuantity Int      @default(0)
  costCents   Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, name])
}
